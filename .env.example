DATABASE_URL="postgresql://havewa:havewa@localhost:5432/havewa?schema=public"
# openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_TRUST_HOST=true

# --- Optionaler Bootstrap beim ersten Start (alle optional) ---
# 1) Demo-Datensatz einspielen (Admin: admin@havewa.app / admin).
#    Wenn gesetzt, werden ADMIN_*/TENANT_NAME ignoriert.
# SEED_DEMO=true
#
# 2) Ohne Demo: Mandant + Admin direkt anlegen -> der Einrichtungs-Wizard entfällt.
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="bitte-aendern"
# ADMIN_NAME="Admin"                    # optional, Standard: "Admin"
# TENANT_NAME="Meine Hausverwaltung"    # optional, Standard: "HaVeWa"
#
# 3) Nichts gesetzt -> Ersteinrichtung über den Wizard beim ersten Login.
